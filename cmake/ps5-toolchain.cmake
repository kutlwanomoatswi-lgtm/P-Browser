set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_C_COMPILER clang-18)
set(CMAKE_CXX_COMPILER clang++-18)
set(CMAKE_LINKER ld.lld-18)
set(CMAKE_AR llvm-ar-18)
set(CMAKE_RANLIB llvm-ranlib-18)
set(CMAKE_C_FLAGS_INIT "-target x86_64-unknown-freebsd12 --sysroot=${PS5_PAYLOAD_SDK}")
set(CMAKE_CXX_FLAGS_INIT "-target x86_64-unknown-freebsd12 --sysroot=${PS5_PAYLOAD_SDK} -fno-exceptions -fno-rtti")
set(CMAKE_FIND_ROOT_PATH ${PS5_PAYLOAD_SDK})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
